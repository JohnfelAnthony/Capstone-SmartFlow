# Set these in the service manager or shell before calling deploy/start-api.ps1.
# Do not commit a populated copy.
SMARTFLOW_ENV=production
SMARTFLOW_PUBLIC_BASE_URL=https://smartflow.example.org
SMARTFLOW_ALLOWED_ORIGINS=https://smartflow.example.org
SMARTFLOW_SECRET_KEY=<unique-random-value-at-least-32-characters>
SMARTFLOW_BOOTSTRAP_ADMIN_PASSWORD=<strong-first-start-password>
SMARTFLOW_SESSION_COOKIE_SECURE=true
SMARTFLOW_DB_PATH=<persistent-storage>/smartflow.db
SMARTFLOW_REGISTRATION_MODE=approval-only
# Optional per-recording cap (seconds); default 3600:
# SMARTFLOW_MAX_RECORDING_SECONDS=3600
# Optional if the network has been restored to a separate directory:
# SMARTFLOW_NETWORK_PATH=<persistent-storage>/tagum_network.json
